# Separate Postgres instance — different host/provider than UGAMAP/UGASHIP
BACKUP_DATABASE_URL=postgresql://user:password@host:5432/uga_backup

# Read-only sync credential used by UGAMAP/UGASHIP to send backup events
BACKUP_SYNC_TOKEN=change-this-to-a-long-random-string

# Separate high-privilege credential required to inspect snapshots/records and initiate restore
BACKUP_RESTORE_TOKEN=change-this-to-a-different-long-random-string

# Optional approved production restore targets
UGAMAP_RESTORE_URL=https://maps.ugandagrid.com/admin/restore
UGASHIP_RESTORE_URL=https://ugandagrid.com/admin/restore

# Separate credentials the backup service presents to each production restore endpoint
UGAMAP_RESTORE_PUSH_TOKEN=change-this-to-a-third-random-string
UGASHIP_RESTORE_PUSH_TOKEN=change-this-to-a-fourth-random-string

# Client-side settings used inside UGAMAP/UGASHIP
BACKUP_SERVICE_URL=https://backup.ugandagrid.com
SOURCE_NAME=UGAMAP
